# OptiVox Frontend — Environment Variables
# Copy this file to .env.local for local overrides (never commit .env.local)
# For Vercel deployment, set these in your Vercel project settings.

# ── Required for Production ───────────────────────────────────────────────

# The full URL of your deployed backend API (no trailing slash)
# Example: https://optivox-backend.railway.app/api
#          https://optivox-backend.onrender.com/api
VITE_API_BASE_URL=

# WebSocket base URL for your deployed backend (no path, no trailing slash)
# Example: wss://optivox-backend.railway.app
#          wss://optivox-backend.onrender.com
# If not set, WebSocket connections will use the current browser host (only
# works if frontend and backend are on the same domain/port, e.g. via a proxy).
VITE_WS_BASE_URL=

# ── Local Development ─────────────────────────────────────────────────────
# In local dev, the Vite proxy (vite.config.js) handles /api → localhost:8000
# so you do NOT need to set VITE_API_BASE_URL locally.
