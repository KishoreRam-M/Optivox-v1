# OptiVox Backend — Environment Variables
# Copy this to .env and fill in the values. Never commit .env to git.

# ── Required ──────────────────────────────────────────────────────────────

# Google Gemini API key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# ── CORS ──────────────────────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins.
# In development, set to * or your localhost port.
# In production, set to your Vercel frontend URL.
# Example: https://optivox.vercel.app,https://optivox-staging.vercel.app
ALLOWED_ORIGINS=*

# ── Storage ───────────────────────────────────────────────────────────────

# Path to the LanceDB vector store directory.
# Default: ./lancedb_data (relative to where the server runs)
# On Railway/Render with a mounted volume, set to the mount path.
# LANCEDB_PATH=./lancedb_data

# Path for the SQLite audit log database.
# Default: /tmp/audit.db (safe for serverless/ephemeral environments)
# For persistent audit logs, set to a volume path.
# AUDIT_DB_PATH=/tmp/audit.db

# ── Server ────────────────────────────────────────────────────────────────

# Port the uvicorn server listens on.
# Most platforms inject $PORT automatically.
# PORT=8000
