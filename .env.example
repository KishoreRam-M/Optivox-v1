# OptiVox Backend — Environment Variables Template
# -------------------------------------------------------
# 1. Copy this file to .env
# 2. Fill in your actual values
# 3. NEVER commit .env to git (it is already in .gitignore)
# -------------------------------------------------------

# -- Required --------------------------------------------------------------

# Google Gemini API key (get free at https://aistudio.google.com/app/apikey)
# Used for: LLM SQL generation (gemini-2.5-flash) + vector embeddings (gemini-embedding-001)
GEMINI_API_KEY=your-gemini-api-key-here

# -- CORS ------------------------------------------------------------------

# Comma-separated list of allowed frontend origins.
# Dev:  ALLOWED_ORIGINS=*
# Prod: ALLOWED_ORIGINS=https://yourapp.vercel.app
ALLOWED_ORIGINS=*

# -- Vector Database (Pinecone) -------------------------------------------

# Pinecone API key (get free at https://app.pinecone.io/)
PINECONE_API_KEY=your-pinecone-api-key-here

# Pinecone index name (auto-created on first startup).
# PINECONE_INDEX_NAME=optivox-rag

# -- Embedding Model -------------------------------------------------------

# Gemini embedding model. Do NOT change EMBEDDING_DIM without recreating the index.
GEMINI_EMBED_MODEL=models/gemini-embedding-001
EMBEDDING_DIM=768

# -- LLM Model -------------------------------------------------------------

# Gemini LLM model. Free tier: 15 RPM · 1M TPM · 1,500 RPD
GEMINI_MODEL=gemini-2.5-flash

# -- Server ----------------------------------------------------------------

# Uvicorn port. Hosting platforms (Render, Railway) inject PORT automatically.
# PORT=8000

# -- Audit Log -------------------------------------------------------------

# Path for the SQLite audit log. Defaults to ~/.optivox/audit.db (cross-platform).
# AUDIT_DB_PATH=/data/audit.db
